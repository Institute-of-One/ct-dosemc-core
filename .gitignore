# --- imaging data: NEVER committed, NEVER redistributed -------------------
# TCIA collections are CC BY, but this project does not redistribute DICOM.
# data/PROVENANCE.json records collection, Series Instance UID, licence and
# retrieval date so the series can be re-fetched; the pixels stay local.
data/**
!data/PROVENANCE.json
!data/README.md
*.dcm
*.DCM
*.nii
*.nii.gz
segmentations/

# --- Monte-Carlo binaries and vendored toolchains -------------------------
# The MC-GPU source is public domain and vendored under vendor/MCGPU, but
# compiled binaries are machine-specific and are rebuilt with
# tools/build_mcgpu.ps1 (which records their SHA-256 in build_info.json).
vendor/build/
vendor/mingw64/
vendor/zlib-*/
vendor/MCGPU/
vendor/MCGPU_materials/
*.exe
*.obj
*.o
*.x

# --- generated material files ---------------------------------------------
# Regenerated by tools/make_materials.py from the PENELOPE photon database;
# materials/PROVENANCE.json (which IS committed) pins their SHA-256.
materials/*.mcgpu
materials/*.mcgpu.gz

# --- per-run Monte-Carlo scratch ------------------------------------------
# results/*.json is committed -- every paper number lives there.  The bulky
# per-run artefacts (voxel geometry, raw tallies, projection images) are not.
results/phase1/**/*.raw
results/phase1/**/*.vox.gz
results/phase1/**/*.mcgpu.gz
results/phase1/**/image.dat*
results/phase1/**/dose.dat
results/phase2/**/*.raw
results/phase2/**/*.vox.gz

# --- python ---------------------------------------------------------------
__pycache__/
*.py[cod]
.venv/
.venv-*/
*.egg-info/
build/
dist/
.pytest_cache/
.ruff_cache/
.coverage
htmlcov/

# --- editors / OS ---------------------------------------------------------
.vscode/
.idea/
Thumbs.db
desktop.ini
