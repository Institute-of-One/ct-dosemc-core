# Local TCIA download/work cache (zips, logs). Not the paper record.
.tcia_work/

# Agent/local scratch. Never a paper artefact; a `_tmp_show_metal.py` of this
# kind is what leaks into a Zenodo deposit if it sits in the working tree.
_tmp*.py
tmp_*.py

# --- imaging data: NEVER committed, NEVER redistributed -------------------
# TCIA collections are CC BY, but this project does not redistribute DICOM.
# data/PROVENANCE.json records collection, Series Instance UID, licence and
# retrieval date so the series can be re-fetched; the pixels stay local.
# Exclude the contents level by level rather than with data/**: git will not
# descend into an excluded directory, so a nested !negation can never re-include
# anything underneath one.
data/*
!data/README.md
!data/PROVENANCE.json
!data/tg195/
# AAPM Report 195 and its electronic resources are free to download but
# copyrighted ((c) 2015 AAPM, all rights reserved).  Same rule as the DICOM:
# fetch and use locally, never redistribute.  Only the digests are committed.
data/tg195/*
!data/tg195/PROVENANCE.json
*.dcm
*.DCM
*.nii
*.nii.gz
segmentations/

# --- Monte-Carlo binaries and vendored toolchains -------------------------
# The MC-GPU source is public domain and vendored under vendor/MCGPU, but
# compiled binaries are machine-specific and are rebuilt with
# tools/build_mcgpu.ps1 (which records their SHA-256 in build_info.json).
vendor/build/
vendor/mingw64/
vendor/zlib-*/
vendor/MCGPU/
vendor/MCGPU_materials/
*.exe
*.obj
*.o
*.x

# --- generated material files ---------------------------------------------
# Regenerated by tools/make_materials.py from the PENELOPE photon database;
# materials/PROVENANCE.json (which IS committed) pins their SHA-256.
materials/*.mcgpu
materials/*.mcgpu.gz

# --- per-run Monte-Carlo scratch ------------------------------------------
# results/*.json is committed -- every paper number lives there.  The bulky
# per-run artefacts (voxel geometry, raw tallies, projection images) are not.
results/**/*.raw
results/**/*.vox.gz
results/**/*.mcgpu.gz
results/**/image*.dat*
results/**/dose*.dat
# One engine invocation per (projection, sub-fan) leaves up to several thousand
# logs, input decks and spectra per campaign. The JSON is the record; the
# per-beamlet scratch is regenerated by re-running the phase.
#
# These are matched across all of results/ rather than per phase. They were once
# written per phase, and results/phase2_ctdi/ -- added later -- escaped the policy
# entirely: 2 052 scratch files, 15 MB, staged for commit, with 8.8 GB of .raw and
# .dat underneath them held back only by the global patterns above. A rule that
# names one phase does not survive the next phase.
results/**/*.in
results/**/*.spc
results/**/mcgpu_*.log
results/*.log
results/*.progress.json
# Kept deliberately: campaign.log, cohort.log and watchdog.log are run records,
# one per campaign, and do not match mcgpu_*.log.

# --- python ---------------------------------------------------------------
__pycache__/
*.py[cod]
.venv/
.venv-*/
*.egg-info/
build/
dist/
.pytest_cache/
.ruff_cache/
.coverage
htmlcov/

# --- editors / OS ---------------------------------------------------------
.vscode/
.idea/
Thumbs.db
desktop.ini

# Assembled CUDA tree and cuda-samples clone: fetched, not redistributed.
vendor/cuda-12.9/
vendor/cuda-samples/
